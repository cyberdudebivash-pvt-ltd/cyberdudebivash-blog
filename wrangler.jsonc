{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Still deliberately incapable of a production DNS takeover: no
  // routes, no custom_domains, no production hostname. Safe to build,
  // dry-run, and validate locally until an authenticated operator performs
  // the already-governed production deployment.

  "name": "cyberdudebivash-blog",
  "main": "workers/entry.js",
  "compatibility_date": "2026-08-17",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist-public",
    "binding": "ASSETS",
    "html_handling": "none"
  },

  "rules": [
    { "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true },
    { "type": "Data", "globs": ["**/*.woff"], "fallthrough": true }
  ],

  "observability": {
    "enabled": true
  },

  // Canonical customer/control-plane D1 database. The migration directory now
  // also contains 0008_premium_intelligence_commerce.sql; applying migrations
  // is an explicit operator step before enabling premium commerce in production.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sentinel-apex-core",
      "migrations_dir": "./migrations"
    }
  ],

  // Premium ReportX artifacts. This binding is intentionally Cloudflare-native:
  // no AWS SDK, S3 compatibility credentials, or public bucket URL is used by
  // the commerce engine. Create the bucket before deployment with an authorized
  // Cloudflare operator (`wrangler r2 bucket create sentinel-apex-premium-reports`).
  // Checkout fails closed if the bound artifact cannot be HEAD-verified against
  // the exact artifact SHA-256 pinned by ReportX human certification.
  "r2_buckets": [
    {
      "binding": "PREMIUM_REPORTS",
      "bucket_name": "sentinel-apex-premium-reports"
    }
  ],

  "triggers": {
    "crons": ["*/30 * * * *"]
  }

  // Intentionally absent (do not add without a separate, explicit
  // authorization step):
  //   routes                — would start claiming a hostname/path
  //   custom_domains        — would touch DNS
  //   kv_namespaces         — no blog-owned namespace is justified here
  //   services              — no service bindings to other platforms required
  //   vars / secrets with real values — use Cloudflare secrets/vars; never commit
}
