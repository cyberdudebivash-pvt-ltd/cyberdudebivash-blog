{
  "version": 2,

  "ignoreCommand": "bash vercel-ignore-build.sh",

  "functions": {
    "api/v1/intel.js":           { "memory": 256, "maxDuration": 15 },
    "api/v1/auth.js":            { "memory": 128, "maxDuration": 10 },
    "api/v1/billing.js":         { "memory": 256, "maxDuration": 15 },
    "api/v1/admin.js":           { "memory": 256, "maxDuration": 20 },
    "api/v1/billing/webhook.js": { "memory": 128, "maxDuration": 10 },
    "api/v1/billing/razorpay-webhook.js": { "memory": 128, "maxDuration": 10 },
    "api/cron/dispatch-intel.js": { "memory": 128, "maxDuration": 10 },
    "api/og.js":                  { "memory": 512, "maxDuration": 15 }
  },

  "headers": [
    {
      "source": "/api/v1/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Authorization, X-API-Key, Content-Type, X-Admin-Key, stripe-signature" },
        { "key": "X-Content-Type-Options",       "value": "nosniff" },
        { "key": "X-Frame-Options",              "value": "DENY" },
        { "key": "Content-Security-Policy",      "value": "default-src 'none'; frame-ancestors 'none'" },
        { "key": "Referrer-Policy",              "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",           "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Cache-Control",               "value": "no-store, no-cache, must-revalidate" },
        { "key": "X-Powered-By",                 "value": "CYBERDUDEBIVASH SENTINEL APEX v4.0" }
      ]
    },
    {
      "source": "/api/cron/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",  "value": "nosniff" },
        { "key": "X-Frame-Options",         "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; frame-ancestors 'none'" },
        { "key": "Referrer-Policy",         "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",      "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Cache-Control",           "value": "no-store, no-cache, must-revalidate" },
        { "key": "X-Powered-By",            "value": "CYBERDUDEBIVASH SENTINEL APEX v4.0" }
      ]
    },
    {
      "source": "/api/(.*).json",
      "headers": [
        { "key": "Content-Type",                 "value": "application/json; charset=UTF-8" },
        { "key": "Cache-Control",                "value": "public, max-age=600, stale-while-revalidate=3600" },
        { "key": "Access-Control-Allow-Origin",  "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, OPTIONS" },
        { "key": "X-Content-Type-Options",       "value": "nosniff" },
        { "key": "X-Powered-By",                 "value": "CYBERDUDEBIVASH SENTINEL APEX v4.0" }
      ]
    },
    {
      "source": "/rss.xml",
      "headers": [
        { "key": "Content-Type",                "value": "application/rss+xml; charset=UTF-8" },
        { "key": "Cache-Control",               "value": "public, max-age=3600, stale-while-revalidate=86400" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "X-Content-Type-Options",      "value": "nosniff" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type",                "value": "application/xml; charset=UTF-8" },
        { "key": "Cache-Control",               "value": "public, max-age=3600" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type",  "value": "text/plain; charset=UTF-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control",          "value": "public, max-age=3600, stale-while-revalidate=86400" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "Content-Security-Policy","value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://www.googletagmanager.com https://www.google-analytics.com https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://blog.cyberdudebivash.in https://www.google-analytics.com https://region1.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://api.rss2json.com https://api.allorigins.win https://corsproxy.io https://thingproxy.freeboard.io https://api.razorpay.com https://checkout.razorpay.com https://lumberjack.razorpay.com; frame-src 'self' https://api.razorpay.com https://checkout.razorpay.com; frame-ancestors 'none'" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",     "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(.*).js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=600, stale-while-revalidate=86400" },
        { "key": "Content-Type",  "value": "application/javascript; charset=UTF-8" }
      ]
    },
    {
      "source": "/(.*).css",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-DNS-Prefetch-Control",    "value": "on" },
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "X-Frame-Options",           "value": "DENY" },
        { "key": "Referrer-Policy",           "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],

  "rewrites": [

    { "source": "/CLAUDE.md",                          "destination": "/api/_lib/blocked-404" },
    { "source": "/Sentinel-APEX/:path*",                "destination": "/api/_lib/blocked-404" },
    { "source": "/eito/:path*",                         "destination": "/api/_lib/blocked-404" },
    { "source": "/platform/:path*",                     "destination": "/api/_lib/blocked-404" },
    { "source": "/prompts/:path*",                      "destination": "/api/_lib/blocked-404" },
    { "source": "/BUSINESS-TRANSFORMATION-ROADMAP-2026.md", "destination": "/api/_lib/blocked-404" },
    { "source": "/AUDIT-REPORT-2026-05-28.md",          "destination": "/api/_lib/blocked-404" },
    { "source": "/OPERATIONS.md",                       "destination": "/api/_lib/blocked-404" },

    { "source": "/api/v1/billing/webhook",          "destination": "/api/v1/billing/webhook" },
    { "source": "/api/v1/billing/razorpay-webhook", "destination": "/api/v1/billing/razorpay-webhook" },

    { "source": "/api/v1/intel/live",                  "destination": "/api/v1/intel?action=live" },
    { "source": "/api/v1/intel/top-threats",           "destination": "/api/v1/intel?action=top" },
    { "source": "/api/v1/intel/cve/:id",               "destination": "/api/v1/intel?action=cve&id=:id" },
    { "source": "/api/v1/intel/iocs",                  "destination": "/api/v1/intel?action=iocs" },
    { "source": "/api/v1/intel/ransomware",            "destination": "/api/v1/intel?action=ransomware" },
    { "source": "/api/v1/intel/search",                "destination": "/api/v1/intel?action=search" },
    { "source": "/api/v1/intel/graph",                 "destination": "/api/v1/intel?action=graph" },
    { "source": "/api/v1/intel/campaigns",             "destination": "/api/v1/intel?action=campaigns" },
    { "source": "/api/v1/intel/campaign/:id",          "destination": "/api/v1/intel?action=campaign&id=:id" },
    { "source": "/api/v1/intel/top-actors",            "destination": "/api/v1/intel?action=top-actors" },

    { "source": "/api/v1/auth/register",               "destination": "/api/v1/auth?action=register" },
    { "source": "/api/v1/auth/me",                     "destination": "/api/v1/auth?action=me" },
    { "source": "/api/v1/keys/usage",                  "destination": "/api/v1/auth?action=usage" },

    { "source": "/api/v1/billing/create-intent",       "destination": "/api/v1/billing?action=create-intent" },
    { "source": "/api/v1/billing/submit-payment",      "destination": "/api/v1/billing?action=submit-payment" },
    { "source": "/api/v1/billing/payment-status",      "destination": "/api/v1/billing?action=status" },
    { "source": "/api/v1/billing/subscribe",           "destination": "/api/v1/billing?action=subscribe" },
    { "source": "/api/v1/billing/razorpay/order",      "destination": "/api/v1/billing?action=create-razorpay-order" },
    { "source": "/api/v1/billing/razorpay/verify",     "destination": "/api/v1/billing?action=verify-razorpay-payment" },
    { "source": "/api/v1/billing/products/checkout",  "destination": "/api/v1/billing?action=create-product-checkout" },

    { "source": "/api/v1/admin/payments/pending",      "destination": "/api/v1/admin?action=pending" },
    { "source": "/api/v1/admin/payments/approve",      "destination": "/api/v1/admin?action=approve" },
    { "source": "/api/v1/admin/payments/reject",       "destination": "/api/v1/admin?action=reject" },
    { "source": "/api/v1/admin/payments/audit",        "destination": "/api/v1/admin?action=audit" },
    { "source": "/api/v1/admin/payments/razorpay-orders", "destination": "/api/v1/admin?action=razorpay-orders" },
    { "source": "/api/v1/admin/payments/product-orders",  "destination": "/api/v1/admin?action=product-orders" },

    { "source": "/api/v1/workbench/investigations/:apexSubpath*", "destination": "/api/v1/workbench/investigations?apexSubpath=:apexSubpath*" },
    { "source": "/api/v1/workbench/cases/:apexSubpath*",          "destination": "/api/v1/workbench/cases?apexSubpath=:apexSubpath*" },
    { "source": "/api/v1/intelligence/graph/:apexSubpath*",       "destination": "/api/v1/intelligence/graph?apexSubpath=:apexSubpath*" },
    { "source": "/api/v1/intelligence/correlations/:apexSubpath*", "destination": "/api/v1/intelligence/correlations?apexSubpath=:apexSubpath*" },
    { "source": "/api/v1/intelligence/objects/:apexSubpath*",      "destination": "/api/v1/intelligence/objects?apexSubpath=:apexSubpath*" },
    { "source": "/api/v1/intelligence/similarity/:apexSubpath*",   "destination": "/api/v1/intelligence/similarity?apexSubpath=:apexSubpath*" },
    { "source": "/api/v1/intelligence/publish/:apexSubpath*",      "destination": "/api/v1/intelligence/publish?apexSubpath=:apexSubpath*" },

    { "source": "/feed",     "destination": "/rss.xml" },
    { "source": "/feed.xml", "destination": "/rss.xml" },
    { "source": "/atom.xml", "destination": "/rss.xml" }
  ],

  "redirects": [
    { "source": "/rss", "destination": "/rss.xml", "permanent": true }
  ],

  "cleanUrls": false,
  "trailingSlash": false
}
