# ============================================================
# CYBERDUDEBIVASH SENTINEL APEX v4.0 — Environment Variables
# ============================================================
# Copy this file to .env.local for local dev.
# Set all variables in: Vercel Dashboard → Project → Settings → Environment Variables
# ============================================================

# ----------------------------------------------------------
# UPSTASH REDIS (REQUIRED)
# Get from: https://console.upstash.com → Create Database → REST API
# ----------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# ----------------------------------------------------------
# STRIPE BILLING (REQUIRED for paid tiers)
# Get from: https://dashboard.stripe.com → Developers → API Keys
# ----------------------------------------------------------
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs from: Stripe Dashboard → Products → (your product) → Pricing
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ----------------------------------------------------------
# MANUAL PAYMENT SYSTEM (REQUIRED for UPI/Bank billing)
# ----------------------------------------------------------

# Admin secret key — protects /api/v1/admin/payments/* endpoints
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set this in Vercel AND keep a copy in your password manager
ADMIN_SECRET_KEY=your-strong-random-admin-key-here

# UPI payment details (shown to users in payment instructions)
UPI_ID=cyberdudebivash@upi
UPI_NAME=CYBERDUDEBIVASH SENTINEL

# Bank transfer details (for NEFT/IMPS payments)
BANK_NAME=CYBERDUDEBIVASH TECHNOLOGIES
BANK_ACCOUNT=your-account-number
BANK_IFSC=your-ifsc-code
BANK_LABEL=Your Bank Name

# ----------------------------------------------------------
# SITE CONFIG
# ----------------------------------------------------------
NEXT_PUBLIC_BASE_URL=https://blog.cyberdudebivash.in

# ----------------------------------------------------------
# STRIPE WEBHOOK SETUP (manual step)
# 1. Go to https://dashboard.stripe.com/webhooks
# 2. Add endpoint: https://blog.cyberdudebivash.in/api/v1/billing/webhook
# 3. Select events:
#    - checkout.session.completed
#    - customer.subscription.updated
#    - customer.subscription.deleted
#    - invoice.payment_failed
# 4. Copy the Signing Secret → paste as STRIPE_WEBHOOK_SECRET above
# ----------------------------------------------------------
