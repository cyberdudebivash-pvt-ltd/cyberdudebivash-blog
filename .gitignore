# ============================================================
# CYBERDUDEBIVASH SENTINEL APEX — .gitignore
# ============================================================

# Environment variables — NEVER commit secrets
.env
.env.local
.env.production
.env.staging
*.env

# Node modules
node_modules/
npm-debug.log*

# Pipeline lock
pipeline.lock

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Editor artifacts
.vscode/
.idea/
*.swp
*.swo
*~

# Build outputs (if added later)
.next/
out/
dist/
build/

# Debug/dump files (never commit raw data exports)
*-dump.txt
dashboard-dump.txt
intel-report-dump.txt
extract_done.txt
git_push_out.txt

# Temporary fix scripts (cleanup after deployment)
fix_descriptions.js
fix_desc2.js

# Deployment scripts (Windows ops — never commit)
*.bat
*.ps1
sentinel_push.bat
sentinel_commit.bat
sentinel_deploy.bat
git_check.bat

# Admin/debug HTML tools (not for public indexing or version control)
check-index-ga4.html
admin-dashboard.html
admin-payments.html
leads.html

# Deployment logs and temp outputs
push_result.txt
git_push_out.txt
commit_out.txt
deploy_log.txt
*.log

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# Test coverage reports
coverage/
pipeline-health-history.json
