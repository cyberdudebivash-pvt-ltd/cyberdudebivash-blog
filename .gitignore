# ============================================================
# CYBERDUDEBIVASH SENTINEL APEX — .gitignore
# ============================================================

# Environment variables — NEVER commit secrets
.env
.env.local
.env.production
.env.staging
*.env

# Node modules
node_modules/
npm-debug.log*

# Pipeline lock
pipeline.lock

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Editor artifacts
.vscode/
.idea/
*.swp
*.swo
*~

# Build outputs (if added later)
.next/
out/
dist/
build/

# Debug/dump files (never commit raw data exports)
*-dump.txt
dashboard-dump.txt
intel-report-dump.txt
extract_done.txt
git_push_out.txt

# Temporary fix scripts (cleanup after deployment)
fix_descriptions.js
fix_desc2.js
